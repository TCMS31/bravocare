# Postgres connection string used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bravocare?schema=public"

# Port the API listens on.
PORT=3000

# development | test | production. Controls request logging and error detail.
NODE_ENV=development

# Allowed browser origin for CORS. Use the client's URL in production.
CORS_ORIGIN=*

# morgan log format: dev, combined, common, short, tiny.
LOG_FORMAT=dev

# Overlap policy, in minutes.
SAME_FACILITY_OVERLAP_ALLOWANCE_MINUTES=30
CROSS_FACILITY_OVERLAP_ALLOWANCE_MINUTES=0

# Pagination bounds for list endpoints.
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200
