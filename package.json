{
  "name": "bravocare-shift-overlap",
  "version": "1.0.0",
  "private": true,
  "description": "Shift overlap and staffing API for the Bravocare exercise",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "NODE_ENV=test node --test \"tests/**/*.test.js\"",
    "test:client": "npm --prefix client test -- --watchAll=false",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node prisma/seed.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^4.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "eslint": "^9.11.1",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^15.9.0",
    "nodemon": "^2.0.20",
    "prettier": "^3.3.3",
    "prisma": "^4.8.1",
    "supertest": "^7.0.0"
  }
}
